# 커밋용 템플릿 — placeholder만. 실제 값은 .env.<env> 에 (gitignore 됨).
# 사용: cp .env.example .env.local  후 값 채우기.
ENV=local                              # local | dev | staging | prod
TRANSPORT=stdio                        # stdio (로컬 호스트) | http (원격·멀티에이전트)
PORT=8080
WEB_PORT=3000
# DB — local: sqlite:///./local.db / dev+: postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///./local.db
# REDIS_URL=redis://redis:6379         # dev+ 에서 사용
EXTRACTOR_URL=http://localhost:8000
# 비밀값은 Vault/Secret Manager 주입. 평문 커밋 금지.
POSTGRES_PASSWORD=__INJECT__

# ── apps/web 인증 (상세: apps/web/.env.example) ──
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10
TOTP_ISSUER=MCP-Proxy
SQLITE_PATH=./var/app.db
# 기본관리자(SUPERVISOR) 초기 설정 — 둘 다 설정 시 첫 부팅에 1회 생성
SUPERVISOR_EMAIL=
SUPERVISOR_PASSWORD=

# dev 테스트 계정 시드 (true 시 ad@x.com/ad1234·us@x.com/us1234 생성)
SEED_TEST_ACCOUNTS=false

# MCP 프록시 사용내역 보고 공유 토큰
USAGE_TOKEN=

# SMTP (초대 메일) — host 미설정 시 메일 대신 링크 반환
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@mcp-proxy.local
