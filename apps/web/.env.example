# apps/web 인증 설정 (커밋용 템플릿 — 실제 값은 .env.local)

# JWT 서명 비밀 (프로덕션 필수 교체)
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# TOTP 발급자명 (인증 앱에 표시)
TOTP_ISSUER=MCP-Proxy

# 사용자 DB (node:sqlite 파일 경로)
SQLITE_PATH=./var/app.db

# 기본관리자(SUPERVISOR) 초기 설정 — 둘 다 설정 시 첫 부팅에 1회 생성
SUPERVISOR_EMAIL=
SUPERVISOR_PASSWORD=

SEED_TEST_ACCOUNTS=false

USAGE_TOKEN=

# SMTP (초대 메일) — host 미설정 시 메일 대신 링크 반환
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@mcp-proxy.local
