{
  "comment": "make seed 전용 — server-only 를 stub 으로 별칭(독립 tsx 실행). Next 빌드와 분리.",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "server-only": ["../../../test/stubs/server-only.ts"]
    }
  },
  "include": ["seed.ts", "../lib/server/**/*.ts"]
}
